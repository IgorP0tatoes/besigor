# Public address of the panel: used in the agent install snippet.
APP_URL=https://monitor.example.com

ADMIN_USER=admin
# Use a long random password: openssl rand -base64 24
ADMIN_PASSWORD=

# Set to true only when the hub is proxied by Cloudflare (orange cloud).
TRUST_CLOUDFLARE=false

# Proxies allowed to set X-Forwarded-For. Default: loopback and private networks.
# TRUSTED_PROXIES=127.0.0.1/8,172.16.0.0/12

# LOG_LEVEL=info
